{
  "schema_version": 1,
  "name": "current_product_join_fixed",
  "business_requirement": "Final datasets include paid order-line snapshots only and preserve one row per order_item_id. Product history contains older versions; enrichment must use the single row per product with is_current = 1. Original amounts are CNY, and product enrichment must not change those amounts.",
  "sources": [
    {
      "table": "orders",
      "csv": "orders.csv",
      "contract": "orders.contract.json",
      "money": {
        "field": "amount",
        "integer_column": "amount_cents"
      }
    },
    {
      "table": "products",
      "csv": "products.csv"
    }
  ],
  "pipelines": {
    "A": [
      {
        "id": "filter",
        "output": "a_filtered",
        "sql": "sql/a_filter.sql"
      },
      {
        "id": "prepare_products",
        "output": "a_products_current",
        "sql": "sql/current_products.sql"
      },
      {
        "id": "enrich",
        "output": "a_enriched",
        "sql": "sql/a_enrich.sql",
        "join": {
          "left": "a_filtered",
          "right": "a_products_current",
          "left_on": [
            "product_id"
          ],
          "right_on": [
            "product_id"
          ],
          "expected": "many_to_one"
        }
      }
    ],
    "B": [
      {
        "id": "filter",
        "output": "b_filtered",
        "sql": "sql/b_filter.sql"
      },
      {
        "id": "prepare_products",
        "output": "b_products_current",
        "sql": "sql/current_products.sql"
      },
      {
        "id": "enrich",
        "output": "b_enriched",
        "sql": "sql/b_enrich_current.sql",
        "join": {
          "left": "b_filtered",
          "right": "b_products_current",
          "left_on": [
            "product_id"
          ],
          "right_on": [
            "product_id"
          ],
          "expected": "many_to_one"
        }
      }
    ]
  },
  "checkpoints": [
    {
      "name": "filtered",
      "a": "a_filtered",
      "b": "b_filtered"
    },
    {
      "name": "enriched",
      "a": "a_enriched",
      "b": "b_enriched"
    }
  ],
  "comparison": {
    "key": [
      "order_item_id"
    ],
    "amount_column": "amount_cents",
    "dimensions": [
      "province"
    ],
    "value_columns": [
      "order_id",
      "product_id",
      "order_date",
      "status",
      "province",
      "amount_cents",
      "currency"
    ]
  },
  "query": {
    "filters": [
      {
        "column": "order_date",
        "operator": "eq",
        "value": "2026-10-01"
      }
    ],
    "group_by": [
      "province"
    ]
  }
}
