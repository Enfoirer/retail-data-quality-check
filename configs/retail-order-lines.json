{
  "name": "retail-order-lines-v1",
  "required": ["order_item_id", "order_id", "product_id", "order_date", "amount", "currency", "status"],
  "unique_key": ["order_item_id"],
  "amount": {"field": "amount", "decimal_places": 2},
  "date": {"field": "order_date", "format": "%Y-%m-%d", "review_alternate_formats": true},
  "allowed_values": {
    "currency": ["CNY"],
    "status": ["paid", "cancelled", "refunded"]
  },
  "status_amount": {
    "status_field": "status",
    "rules": {"paid": "positive", "cancelled": "zero", "refunded": "negative"}
  }
}
